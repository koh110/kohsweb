{
  "name": "kohsweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --turbo",
    "build:tsc": "tsc --noEmit",
    "build": "NODE_ENV=production next build",
    "analyze": "ANALYZE=true NODE_ENV=production next build",
    "start": "next start",
    "format": "prettier --write {app,components,contexts,public,styles,types,lib}/**/*.{ts,tsx}",
    "serve": "serve out -l 3000",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:merged": "node scripts/deploy-worker.mts --merged-release",
    "deploy:dry-run": "node scripts/deploy-worker.mts --dry-run",
    "test:deploy": "node --test scripts/deploy-worker.test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "next": "^16.4.6",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remixicon": "^4.9.1",
    "sanitize.css": "^13.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "jsonc-parser": "3.3.1",
    "serve": "^14.2.8",
    "wrangler": "4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  }
}
